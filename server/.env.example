APP_NAME=OpsPilot
APP_ENV=local
APP_VERSION=dev
HTTP_ADDR=:8080
HTTP_ALLOW_ORIGIN=http://localhost:5173

DATABASE_DRIVER=mysql
DATABASE_DSN=opspilot:opspilot@tcp(localhost:3306)/opspilot?charset=utf8mb4&parseTime=True&loc=Local

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

AGENT_API_BASE_URL=http://localhost:8080
AGENT_BOOTSTRAP_SECRET=change-me-agent-bootstrap-secret
AGENT_HEARTBEAT_INTERVAL=30s
